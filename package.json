{
  "name": "tessello-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc -p .",
    "build:sdk": "node packages/sdk/scripts/build-local-copy.ts",
    "build:host": "node packages/host/scripts/build.ts",
    "build:marketplace": "node packages/marketplace/scripts/build-site.ts",
    "build:packages": "node scripts/build-packages.ts",
    "start:host": "npm run build:host && node packages/host/scripts/serve.ts",
    "test:browser": "npm run build:host && node --test --test-concurrency=1 \"packages/*/e2e/*.test.ts\"",
    "test:compiled": "npm run build:packages && node --import ./scripts/use-compiled.ts --test \"packages/*/test/*.test.ts\"",
    "test:packed": "node --test \"packages/*/packed/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3"
  }
}
